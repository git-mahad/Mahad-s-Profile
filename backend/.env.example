# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# ----------------------------------------------------------------------------

# Port the API listens on
PORT=3000

# Comma-separated list of allowed front-end origins (CORS).
# For local testing with a static server use something like:
#   http://localhost:5500,http://127.0.0.1:5500
# In production put your deployed site origin, e.g. https://mahad.dev
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- SMTP (outgoing mail) settings ----
# For Gmail: host=smtp.gmail.com, port=465, secure=true
# You MUST use a Gmail "App Password" (not your normal password) — see README.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.gmail.address@gmail.com
SMTP_PASS=your-16-char-app-password

# Where contact messages are delivered (usually your own inbox)
MAIL_TO=mahad.dev3@gmail.com

# The "From" address shown on the email (usually same as SMTP_USER for Gmail)
MAIL_FROM="Portfolio Contact <your.gmail.address@gmail.com>"
